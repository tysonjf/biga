# Local development secrets. Copy to .dev.vars (git-ignored).
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
PASSWORD_PEPPER=dev-only-pepper
# Cloudflare's "always passes" Turnstile test secret (pairs with the test site key in wrangler.jsonc).
# Leave empty to turn the captcha off locally.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
